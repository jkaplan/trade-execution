MAX_SIGNAL_AGE_MS=900000
ALLOWED_INSTRUMENTS=
ALLOWED_TIMEFRAMES=
LOG_LEVEL=info
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ORDER_UNITS=1
DASHBOARD_AUTH_TOKEN=
